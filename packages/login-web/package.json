{
  "name": "@identity-agent/login-web",
  "version": "0.1.3",
  "description": "Sign In with Identity Agent — React widget + server-side session confirmation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
