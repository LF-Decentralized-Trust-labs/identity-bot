    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "license": "Apache-2.0"
