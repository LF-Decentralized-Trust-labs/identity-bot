__pycache__/
tests/keri_test_vector.json

# Replit
.cache/
.config/
.local/
attached_assets/

# MCP config (personal dev tooling)
.mcp.json

# Claude Code / Codex project instructions (local-only, not for public repo —
# they reference the private strategy repo + planning docs)
CLAUDE.md
AGENTS.md

# Local personal tooling (markdown-to-docx converter, etc.)
md_to_docx.py

# Runtime agent state (AGENT_DATA_DIR) — never commit
data/

# Local Python virtualenvs for the KERI driver — never committed.
.venv-keri/
.venv-keri312/
drivers/keri-core/.venv/

# Key material and an agent's own runtime state, wherever a test or a run
# happens to drop it. A signing key committed to a public repository is
# compromised the moment it is pushed, whatever it was for — and the path it
# lands on depends on where a test pointed its data directory, so exclude the
# shape rather than the one place it has appeared.
*.key
**/data/

# Build outputs, including the Secure Enclave shim the macOS build compiles.
identity-agent-core/build/
