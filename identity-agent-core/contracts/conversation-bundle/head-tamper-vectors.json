{
  "about": "Tampers with the head statement of genuine-bundle-with-head.json. Each vector is an RFC 6902 JSON Patch to apply to that file; the patched file must not verify, for the reason given, and must not be accepted as a head-bearing bundle that does. The control patch changes nothing and must verify, so a checker shows its patching works before it is believed to refuse anything. Each tamper is one the Identity Agent's signature does not cover, or a second spelling of what it does, so nobody could see the change from the signatures alone: a bundle's head is signed text and two signatures, and nothing else of its envelope may be present. A schema cannot say which identity signed, so the one tamper the schema accepts is a head signed by another identity than the bundle's root (schema_refuses false there); a verifier refuses it, as it does every one.",
  "genuine": "genuine-bundle-with-head.json",
  "patch_format": "RFC 6902 (JSON Patch): add, replace and remove, over the parsed file; values are literal.",
  "control": {
    "name": "control-no-change",
    "patch": [],
    "verifies": true
  },
  "vectors": [
    {
      "name": "head-another-algorithm",
      "patch": [
        {
          "op": "replace",
          "path": "/head/protected/alg",
          "value": "authcrypt"
        }
      ],
      "because": "the head's protected alg is not none",
      "schema_refuses": true
    },
    {
      "name": "head-another-encryption",
      "patch": [
        {
          "op": "replace",
          "path": "/head/protected/enc",
          "value": "A256GCM"
        }
      ],
      "because": "the head's protected enc is not none",
      "schema_refuses": true
    },
    {
      "name": "head-another-sender",
      "patch": [
        {
          "op": "replace",
          "path": "/head/protected/skid",
          "value": "EAnotherIdentityAgentAltogether0000000000000"
        }
      ],
      "because": "the head's skid is not the Identity Agent that signed it",
      "schema_refuses": false
    },
    {
      "name": "head-no-sender",
      "patch": [
        {
          "op": "replace",
          "path": "/head/protected/skid",
          "value": ""
        }
      ],
      "because": "the head's skid is empty",
      "schema_refuses": true
    },
    {
      "name": "head-missing-sender",
      "patch": [
        {
          "op": "remove",
          "path": "/head/protected/skid"
        }
      ],
      "because": "the head has no skid at all",
      "schema_refuses": true
    },
    {
      "name": "head-extra-sender-header",
      "patch": [
        {
          "op": "add",
          "path": "/head/protected/apu",
          "value": "x"
        }
      ],
      "because": "the head's protected header carries apu, which nothing signs",
      "schema_refuses": true
    },
    {
      "name": "head-extra-recipient-reference",
      "patch": [
        {
          "op": "add",
          "path": "/head/protected/apv",
          "value": "x"
        }
      ],
      "because": "the head's protected header carries apv, which nothing signs",
      "schema_refuses": true
    },
    {
      "name": "head-another-mode",
      "patch": [
        {
          "op": "replace",
          "path": "/head/mode",
          "value": "authcrypt"
        }
      ],
      "because": "the head's mode is not signed",
      "schema_refuses": true
    },
    {
      "name": "head-a-ciphertext",
      "patch": [
        {
          "op": "replace",
          "path": "/head/ciphertext",
          "value": "AAAA"
        }
      ],
      "because": "the head carries a ciphertext, which nothing signs",
      "schema_refuses": true
    },
    {
      "name": "head-an-iv",
      "patch": [
        {
          "op": "replace",
          "path": "/head/iv",
          "value": "AAAA"
        }
      ],
      "because": "the head carries an iv, which nothing signs",
      "schema_refuses": true
    },
    {
      "name": "head-recipients",
      "patch": [
        {
          "op": "replace",
          "path": "/head/recipients",
          "value": [
            {}
          ]
        }
      ],
      "because": "the head carries a recipient, which nothing signs",
      "schema_refuses": true
    },
    {
      "name": "head-a-sender-key-log",
      "patch": [
        {
          "op": "add",
          "path": "/head/sender_kel",
          "value": [
            {
              "t": "icp"
            }
          ]
        }
      ],
      "because": "the head carries a sender key log, which nothing signs",
      "schema_refuses": true
    },
    {
      "name": "head-another-spelling-of-the-statement",
      "patch": [
        {
          "op": "replace",
          "path": "/head/plaintext",
          "value": ""
        }
      ],
      "because": "the head's plaintext is not the one unpadded base64url spelling of the bytes signed",
      "schema_refuses": true
    },
    {
      "name": "head-another-spelling-of-the-ed25519-signature",
