{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grapeid.org/contracts/app-manifest/app-manifest.schema.json",
  "title": "App manifest",
  "description": "What an app beside an Identity Agent declares, and a runtime and the Identity Agent check (ADR-012). Worked examples, accepted and refused: ../../appmanifest/app-manifest-vectors.json.",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "version",
        "author",
        "execution_type",
        "display_method",
        "network_mode",
        "resources",
        "network",
        "capabilities",
        "log_level",
        "signature",
        "publisher_key",
        "signature_algorithm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "An app's name."
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "execution_type": {
          "enum": [
            "container",
            "compiled"
          ]
        },
        "display_method": {
          "enum": [
            "webview",
            "terminal"
          ]
        },
        "network_mode": {
          "enum": [
            "proxy_required",
            "proxy_optional",
            "isolated",
            "local_only"
          ]
        },
        "container": {
          "$ref": "#/$defs/container"
        },
        "binary": {
          "$ref": "#/$defs/binary"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "log_level": {
          "enum": [
            "none",
            "metadata",
            "full"
          ]
        },
        "signature": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher_key": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature_algorithm": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "api_schema": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "capability",
            "bundle",
            "app"
          ]
        },
        "sub_type": {
          "enum": [
            "go-binary",
            "oci-container",
            "web",
            "paired-native"
          ]
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provided_capability"
          }
        },
        "host_control": {
          "$ref": "#/$defs/host_control"
        },
        "supported_platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platform_binary"
          }
        },
        "isolation": {
          "enum": [
            "sandbox",
            "host"
          ]
        },
        "release_digest": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "description": "The exact release this manifest describes. An app must declare it."
        },
        "encrypted_machine": {
          "enum": [
            "required",
            "preferred",
            "not_needed"
          ],
          "description": "Whether the app needs a machine with encrypted memory (a TEE). An app must declare it."
        }
      },
      "description": "An app manifest. A manifest of kind 'app' must also declare release_digest, encrypted_machine, positive cpu_cores, memory_mb and disk_mb, and network.allowed_domains (an empty list means it reaches no host); any other kind must not carry release_digest or encrypted_machine. appmanifest.Validate is the full rule.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "app"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "release_digest",
              "encrypted_machine"
            ],
            "properties": {
              "network": {
                "required": [
                  "allowed_domains"
                ]
              },
              "resources": {
                "properties": {
                  "cpu_cores": {
                    "exclusiveMinimum": 0
                  },
                  "memory_mb": {
                    "exclusiveMinimum": 0
                  },
                  "disk_mb": {
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "release_digest"
                  ]
                },
                {
                  "required": [
                    "encrypted_machine"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "ports",
        "environment",
        "volumes"
      ],
      "properties": {
        "image": {
          "type": "string"
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "volumes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "display_path": {
          "type": "string"
        }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "args",
        "environment"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "memory_mb",
        "disk_mb",
        "egress_kbps",
        "ingress_kbps"
      ],
      "properties": {
        "cpu_cores": {
          "type": "number"
        },
        "memory_mb": {
          "type": "integer"
        },
        "disk_mb": {
          "type": "integer"
        },
        "egress_kbps": {
          "type": "integer"
        },
        "ingress_kbps": {
          "type": "integer"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tls_mode",
        "allowed_domains",
        "blocked_domains"
      ],
      "properties": {
        "tls_mode": {
          "enum": [
            "mitm",
            "sni_only"
          ]
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/ ]+$"
          }
        },
        "blocked_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "allowed_domains are an app's outbound hosts. An app must declare the list, empty if it reaches no host."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "blocked"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provided_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "request_contract",
        "acdc_scope",
        "enabled_by_default",
        "host_control"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "request_contract": {
          "type": "string"
        },
        "docs": {
          "type": "string"
        },
        "acdc_scope": {
          "type": "string"
        },
        "enabled_by_default": {
          "type": "boolean"
        },
        "host_control": {
          "type": "boolean"
        },
        "require_signed_request": {
          "type": "boolean"
        },
        "minimum_score": {
          "type": "integer"
        }
      }
    },
    "host_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants_required",
        "kill_switch"
      ],
      "properties": {
        "grants_required": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "kill_switch": {
          "type": "boolean"
        }
      }
    },
    "platform_binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "min_version",
        "arch",
        "binary"
      ],
      "properties": {
        "os": {
          "enum": [
            "darwin",
            "windows",
            "linux"
          ]
        },
        "min_version": {
          "type": "string"
        },
        "arch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string"
        }
      }
    }
  }
}
