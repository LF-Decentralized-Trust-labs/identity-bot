{
  "about": "Model calls a body makes through the Identity Agent that keeps the API key, worked through; the rules are in contracts/model-call/model-call.schema.json. Each start is checked against routes, under its model (the model chosen for the AI agent, where one is) and allowance (whether its model calls are held to an allowance). Each outcome is what the request alone decides; what only the Identity Agent knows (the lease, the AI agent's standing, what an allowance has left) is not in it.",
  "limits": {
    "request_largest": 3145728,
    "start_largest": 6291456,
    "part_largest": 2097152,
    "path_longest": 256,
    "answer_longest": 32768,
    "collection_wait_seconds": 20
  },
  "header_names": [
    "Content-Type",
    "Accept",
    "Anthropic-Version",
    "Anthropic-Beta",
    "Openai-Beta"
  ],
  "answer_header_names": [
    "Content-Type",
    "Retry-After",
    "Request-Id",
    "X-Request-Id"
  ],
  "query_parameters": [
    "after_id",
    "before_id",
    "beta",
    "limit"
  ],
  "answer_bound_names": [
    "max_tokens",
    "max_completion_tokens",
    "max_output_tokens"
  ],
  "answer_count_names": [
    "n",
    "best_of"
  ],
  "routes": [
    {
      "method": "POST",
      "path": "/v1/messages"
    },
    {
      "method": "POST",
      "path": "/v1/messages/count_tokens"
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions"
    },
    {
      "method": "GET",
      "path": "/v1/models"
    }
  ],
  "borrowing": {
    "model_calls": "through_identity_agent"
  },
  "starts": [
