        "path": "/v1/messages",
        "query": "beta=true",
        "header": {
          "Anthropic-Version": "2023-06-01",
          "Authorization": "Bearer run-token",
          "User-Agent": "a-program/1.0",
          "X-Api-Key": "run-token",
          "content-type": "application/json"
        },
        "body_b64": "eyJtb2RlbCI6ImV4YW1wbGUtbW9kZWwtMSIsIm1heF90b2tlbnMiOjEwMjQsIm1lc3NhZ2VzIjpbeyJyb2xlIjoidXNlciIsImNvbnRlbnQiOiJIZWxsbyJ9XX0="
