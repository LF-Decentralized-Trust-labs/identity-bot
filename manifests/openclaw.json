{
  "id": "openclaw",
  "name": "OpenClaw",
  "description": "Multi-tenant Node.js/TypeScript web application. Demonstrates complex containerized app sandboxing with full network interception and proxy-mediated egress.",
  "version": "1.0.0",
  "author": "OpenClaw",
  "execution_type": "container",
  "display_method": "webview",
  "network_mode": "proxy_required",
  "container": {
    "image": "louislam/uptime-kuma:1",
    "ports": {
      "3001": "display"
    },
    "environment": {},
    "volumes": {}
  },
  "resources": {
    "cpu_cores": 1,
    "memory_mb": 512,
    "disk_mb": 1024,
    "egress_kbps": 5120,
    "ingress_kbps": 5120
  },
  "network": {
    "tls_mode": "mitm",
    "allowed_domains": [
      "*.npmjs.org",
      "*.npmjs.com",
      "registry.npmjs.org"
    ],
    "blocked_domains": []
  },
  "capabilities": {
    "allowed": ["network"],
    "blocked": ["camera", "microphone", "filesystem"]
  },
  "log_level": "metadata",
  "signature": null,
  "publisher_key": null,
  "signature_algorithm": null
}
