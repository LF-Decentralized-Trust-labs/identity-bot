  "network": {
    "tls_mode": "sni_only",
    "allowed_domains": ["agent.internal"],
    "blocked_domains": []
  },
  "capabilities": {
    "allowed": ["network"],
    "blocked": ["camera", "microphone", "filesystem"]
  },
  "log_level": "full",
  "signature": null,
  "publisher_key": null,
  "signature_algorithm": null
