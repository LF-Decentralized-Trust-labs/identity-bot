entrypoint = "README.md"
modules = ["python-3.11", "dart"]

[nix]
channel = "stable-24_11"
packages = ["flutter", "go", "python-3.11", "libsodium", "cloudflared", "rustc", "cargo", "rustup", "cacert"]

[[ports]]
localPort = 5050
externalPort = 80

[env]
PORT = "5050"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh ./scripts/start-backend.sh"
waitForPort = 5050

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh ./scripts/build-flutter.sh"

[userenv]

[userenv.shared]
PORT = "5050"
KERI_HELPER_URL = "https://keri-helper-microservice.replit.app"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "./scripts/deploy-build.sh"]
run = ["sh", "./scripts/deploy-run.sh"]
